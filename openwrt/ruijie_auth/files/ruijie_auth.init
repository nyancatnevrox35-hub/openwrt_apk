#!/bin/sh /etc/rc.common
# Ruijie 802.1X EAP-MD5 authentication client - procd init script

USE_PROCD=1

START=95
STOP=10

PROG=/usr/sbin/ruijie_auth
CONFIG=ruijie_auth

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show whether the client is running"

start_service() {
    local enabled iface username password mac dhcp dhcp_cmd servers

    config_load "$CONFIG"

    config_get_bool enabled "$CONFIG" enabled 0
    [ "$enabled" -eq 1 ] || return 0

    config_get iface "$CONFIG" interface
    config_get username "$CONFIG" username
    config_get password "$CONFIG" password
    config_get mac "$CONFIG" mac
    config_get_bool dhcp "$CONFIG" dhcp 0
    config_get dhcp_cmd "$CONFIG" dhcp_cmd
    config_get servers "$CONFIG" servers

    [ -n "$iface" ] || iface="eth0"
    if [ -z "$username" ] || [ -z "$password" ]; then
        logger -t "$CONFIG" "username/password not configured; not starting"
        return 0
    fi

    procd_open_instance
    procd_set_param command "$PROG" -i "$iface" -u "$username" -p "$password" --log-file /var/log/ruijie_auth.log
    [ -n "$mac" ] && procd_append_param command -m "$mac"
    [ "$dhcp" -eq 1 ] && procd_append_param command --dhcp
    [ -n "$dhcp_cmd" ] && procd_append_param command --dhcp-cmd "$dhcp_cmd"
    [ -n "$servers" ] && procd_append_param command --servers "$servers"

    procd_set_param respawn
    procd_set_param file /etc/config/ruijie_auth
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

status() {
    if pgrep -f "$PROG" >/dev/null 2>&1; then
        echo "running"
        return 0
    fi
    echo "stopped"
    return 1
}
